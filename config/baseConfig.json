{
    "experiment_name": "test_experiment",
    "horizon": 3,
    "tickers": [
                "PG",
                "KO",
                "COST"
              ],
    "benchmark": "^GSPC",
    "strategy": "long_only",
    "data": {
        "end_date": "today",
        "lookback_days": 1825,
        "interval": "1d",
        "splits": 2,
        "raw_data_path": "/data/raw/",
        "processed_data_path": "/data/processed/",
        "split_data_path": "/data/datasets/"
    },
    "model": {
        "model_type": "random_forest",
        "hyperparams": {
            "n_estimators": 500,
            "max_depth": "None"
        }
    },
    "features": {
        "return_windows": [1, 5, 21, 63, 126],
        "volatility_windows": [5, 21, 63, 126],
        "momentum_windows": [5, 21, 63, 126, 252],
        "lags": [1, 5, 21],
        "rsi_windows": [14, 21],
        "sma_windows": [50, 100, 200],
        "ema_windows": [50, 100, 200],
        "macd_params": [[12, 26, 9]]
    },
    "training": {
        "output_dir": "/training/artifacts"
    },
    "metrics": [
        "mse",
        "r2",
        "rank_ic"
    ],
    "s3": {
        "upload": true,
        "bucket": "ml-signal-service"
    }
}